{
  "name": "burken-restaurant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "format": "oxfmt",
    "generate:importmap": "node scripts/run.mjs payload generate:importmap",
    "generate:types": "node scripts/run.mjs payload generate:types",
    "payload": "node scripts/run.mjs payload",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "verify:local": "node scripts/verification/verify-local.mjs",
    "db:upgrade": "node scripts/run.mjs payload run scripts/maintenance/upgrade-local.ts",
    "verify:delivery": "node scripts/verification/verify-delivery.mjs",
    "test:auth-ui": "vitest run",
    "verify:checkout-auth": "node scripts/verification/verify-checkout-auth.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@payloadcms/db-sqlite": "4.0.0-beta.3",
    "@payloadcms/next": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/translations": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "graphql": "^16.8.1",
    "html-react-parser": "^5.2.10",
    "lucide-react": "^1.61.0",
    "monaco-editor": "0.55.1",
    "next": "16.4.0",
    "payload": "4.0.0-beta.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
